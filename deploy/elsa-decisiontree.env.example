# The whole configuration of a deployment (docs/deployment.md). Copy to
# /etc/elsa-decisiontree.env and edit. systemd reads this file as KEY=VALUE lines: no
# shell, no quotes needed, no expansion.

# The Tree this deployment serves: the folder name under ELSA_TREES_DIR. Required -- there
# is no default, and the server refuses to start without it (docs/specs/application.md 2).
ELSA_TREE=ai-act-applicability-agrifood

# Where the Tree folders live. Data, kept outside the application folder so that a new
# build does not touch it and a new Tree version does not touch the application.
ELSA_TREES_DIR=/opt/elsa-decisiontree/trees

# The address readers reach this deployment at -- the reverse proxy's, not this process's.
# It is the origin in the canonical link of every page. Leave it out and that link stays a
# path, which is correct for a reader and short of one address only for a crawler.
ELSA_BASE_URL=https://elsa.example.org

# Where the process listens. Loopback, because the reverse proxy in front terminates TLS
# and is the only thing that talks to it. Set HOSTNAME=0.0.0.0 only to expose the app
# directly, without TLS, which is for a test machine and not for readers.
PORT=3000
HOSTNAME=127.0.0.1
