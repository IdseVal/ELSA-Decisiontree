# The whole configuration of a deployment (docs/deployment.md). Copy to
# /etc/elsa-decisiontree.env, make it readable by root alone (chmod 0600: it holds the
# administrator's password at the first start), and edit. systemd reads this file as
# KEY=VALUE lines: no shell, no quotes needed, no expansion.

# The one folder the service writes: every Tree, under trees/<tree-id>/. Required -- there
# is no default, and the server refuses to start without it. Kept outside the application
# folder so that a release does not touch it (docs/specs/application.md 17). Every
# published Tree in it is served, with an overview of them at /. The first start fills it
# from ELSA_SEED_DIR, which defaults to the trees/ the build carries.
# ELSA_TREE, ELSA_TREES_DIR and ELSA_TREE_LASTMOD are retired: set, the server refuses to start.
ELSA_DATA_DIR=/opt/elsa-decisiontree/data

# The address readers reach this deployment at -- the reverse proxy's, not this process's.
# It is the origin this deployment advertises: the canonical and hreflang links of every
# page, every URL in /sitemap.xml, and the Sitemap: line of /robots.txt. Leave it out and
# those documents carry the address each request arrived on instead, which is right only
# as long as the proxy passes the public host through (docs/specs/application.md 16).
ELSA_BASE_URL=https://elsa.example.org

# The administrator's password, 12 to 256 characters: the account `admin` at /admin, which
# creates every other account. Read at EVERY start -- it creates the administrator the first
# time and resets its password every time after -- so REMOVE THIS LINE after the first start,
# and set it again only to recover a lost password. There is no default; a first start
# without it refuses to start. The login needs HTTPS in front of this process (the session
# cookie is Secure). docs/deployment.md, "The administrator and the login".
ELSA_ADMIN_PASSWORD=

# Where the process listens. Loopback, because the reverse proxy in front terminates TLS
# and is the only thing that talks to it. Set HOSTNAME=0.0.0.0 only to expose the app
# directly, without TLS, which is for a test machine and not for readers.
PORT=3000
HOSTNAME=127.0.0.1
