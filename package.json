{
  "name": "elsa-decisiontree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ELSA decision-tree frontend: shows one Node of an elsa-tree/1 Tree at a time",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/collect-standalone.ts",
    "start": "node .next/standalone/server.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.ts"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
